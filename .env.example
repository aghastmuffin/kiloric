# Appwrite Console → Project Settings
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your-project-id

# Platform ID from Appwrite Console → your iOS/Android app (bundle / package name)
EXPO_PUBLIC_APPWRITE_PLATFORM_ID=co.taeson.calcount

# Optional: separate Web platform hostname if you registered one in Appwrite
# EXPO_PUBLIC_APPWRITE_PLATFORM_WEB=localhost

# Appwrite Console → Databases
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your-database-id
EXPO_PUBLIC_APPWRITE_PROFILES_COLLECTION_ID=users
EXPO_PUBLIC_APPWRITE_MEALS_COLLECTION_ID=meals
EXPO_PUBLIC_APPWRITE_WATER_COLLECTION_ID=water_logs

# Food log, meal plan, training and weight tables (see docs/appwrite/feature-tables.md).
# Defaults match the ids in appwrite.config.json; override only if you renamed them.
# EXPO_PUBLIC_APPWRITE_FOOD_ENTRIES_COLLECTION_ID=food_entries
# EXPO_PUBLIC_APPWRITE_SAVED_MEALS_COLLECTION_ID=saved_meals
# EXPO_PUBLIC_APPWRITE_PLAN_ENTRIES_COLLECTION_ID=meal_plan_entries
# EXPO_PUBLIC_APPWRITE_PREP_SESSIONS_COLLECTION_ID=prep_sessions
# EXPO_PUBLIC_APPWRITE_GROCERY_ITEMS_COLLECTION_ID=grocery_items
# EXPO_PUBLIC_APPWRITE_WORKOUTS_COLLECTION_ID=workouts
# EXPO_PUBLIC_APPWRITE_WORKOUT_SETS_COLLECTION_ID=workout_sets
# EXPO_PUBLIC_APPWRITE_WEIGHT_LOGS_COLLECTION_ID=weight_logs

# Personal tasks / daily quests (dedicated TablesDB)
EXPO_PUBLIC_APPWRITE_TASKS_DATABASE_ID=tasks
EXPO_PUBLIC_APPWRITE_TASKS_COLLECTION_ID=tasks

# Food contributions (see docs/appwrite/food-contributions.md)
EXPO_PUBLIC_APPWRITE_FOODS_DATABASE_ID=your-foods-database-id
EXPO_PUBLIC_APPWRITE_FOOD_CONTRIBUTIONS_COLLECTION_ID=food_contributions
EXPO_PUBLIC_APPWRITE_FOOD_IMAGES_BUCKET_ID=your-images-to-check-bucket-id
# Profiles / meals / water / food contributions need Users → Create (see docs/appwrite/)
# Server-only (never commit): APPWRITE_API_KEY=... for scripts/setup-*.mjs
