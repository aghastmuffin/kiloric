# Appwrite Console → Project Settings
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your-project-id

# Platform ID from Appwrite Console → your iOS/Android app (bundle / package name)
EXPO_PUBLIC_APPWRITE_PLATFORM_ID=co.taeson.calcount

# Optional: separate Web platform hostname if you registered one in Appwrite
# EXPO_PUBLIC_APPWRITE_PLATFORM_WEB=localhost

# Appwrite Console → Databases
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your-database-id
EXPO_PUBLIC_APPWRITE_PROFILES_COLLECTION_ID=users
EXPO_PUBLIC_APPWRITE_MEALS_COLLECTION_ID=meals
EXPO_PUBLIC_APPWRITE_WATER_COLLECTION_ID=water_logs
# Profiles / meals / water need Users → Create (see docs/appwrite/)
# Server-only (never commit): APPWRITE_API_KEY=... for scripts/setup-*.mjs
