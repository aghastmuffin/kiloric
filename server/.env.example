# Database URL:
#   SQLite (dev):     sqlite:///./kiloric.db
#   PostgreSQL (prod): postgresql://kiloric:PASSWORD@localhost:5432/kiloric
DATABASE_URL=sqlite:///./kiloric.db

# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_BYTE_HEX

JWT_ALGORITHM=HS256

# Access token TTL in minutes (15 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token TTL in days (30 days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated allowed origins (no trailing slash)
# e.g.: http://localhost:8081,https://kiloric.kiloric.co
CORS_ORIGINS=https://aghastmuffin.github.io,https://kiloric.co,https://www.kiloric.co,http://localhost:8081

# Email reset — use any SMTP-compatible sender (mailgun, resend, sendgrid, etc.)
# Leave empty to disable password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@kiloric.co

# Deep-link scheme used in password-reset emails
APP_RESET_URL=https://kiloric.co/app/reset-password
