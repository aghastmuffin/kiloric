[Unit]
Description=Kiloric API Server
After=network.target postgresql.service

[Service]
User=kiloric
WorkingDirectory=/opt/kiloric-server
EnvironmentFile=/opt/kiloric-server/.env
ExecStart=/opt/kiloric-server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
