{
  "expo": {
    "name": "CalCount",
    "slug": "taesonco-calcount",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "calorie",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "co.taeson.calcount",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121110",
        "foregroundImage": "./assets/images/app-mark.png",
        "monochromeImage": "./assets/images/app-mark-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "co.taeson.calcount"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "redirects": [
            { "source": "/meals", "destination": "/logfood" },
            { "source": "/searchrewrite", "destination": "/logfood" }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121110",
          "android": {
            "image": "./assets/images/app-mark.png",
            "imageWidth": 112
          }
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to scan food barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to choose food and nutrition label photos.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to photograph food and nutrition labels.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34027bcb-27eb-4a2d-99c2-5beb80814599"
      }
    },
    "owner": "taesonco"
  }
}
