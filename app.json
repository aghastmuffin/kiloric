{
  "expo": {
    "name": "taesonco-calcount",
    "slug": "taesonco-calcount",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dark.png",
    "scheme": "calorie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/dark.png",
      "bundleIdentifier": "co.taeson.calcount",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F8F4",
        "foregroundImage": "./assets/images/dark.png",
        "backgroundImage": "./assets/images/dark.png",
        "monochromeImage": "./assets/images/dark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "co.taeson.calcount"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8F4",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34027bcb-27eb-4a2d-99c2-5beb80814599"
      }
    },
    "owner": "taesonco"
  }
}
